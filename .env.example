
MONGODB_URI="your mongodb connection string here"

# --- Auth ---
JWT_SECRET="your-jwt-secret-here"
CRON_SECRET="your-cron-secret-here"
REGISTER_SECRET="your-register-secret-here"
ENCRYPTION_KEY="your-encryption-key-here"

# Comma-separated emails that get admin visibility (see everyone's campaigns
# and images) when they log in normally. No separate login/PIN.
ADMIN_EMAILS="admin@example.com"

# number of smtp connections in pool
REMINDER_USER_CONCURRENCY=4

# Public origin used to build the never-expiring preview links that get emailed
# to sales ("Send to sales" on the images screen). Must be reachable from
# outside — a link built on localhost is useless in someone's inbox. Falls back
# to the request's own host when unset.
APP_BASE_URL="https://your-deployed-app.example.com"

APPWRITE_ENDPOINT="https://cloud.appwrite.io/v1"
APPWRITE_PROJECT_ID="replace-with-appwrite-project-id"
APPWRITE_API_KEY="replace-with-appwrite-api-key"
APPWRITE_BUCKET_ID="replace-with-appwrite-bucket-id"

# A dedicated Appwrite user whose only bucket grant is `create`. The server
# mints short-lived JWTs for it so the browser can upload files straight to
# Appwrite — Vercel caps a function's request body at ~4.5MB, well under our
# own file limits. It can add a file, never list, read or delete one.
APPWRITE_UPLOAD_USER_ID="replace-with-appwrite-upload-user-id"

REMINDER_ERROR_REPORT_TO = "replace-with-email-for-error-reports-it-sends-the-reminder-error-report-to-this-address"    