# --- Database (MongoDB) ---
# Local:  mongodb://127.0.0.1:27017/campaign_tracker
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>/campaign_tracker
MONGODB_URI="mongodb://127.0.0.1:27017/campaign_tracker"

# --- Auth ---
# Secret used to sign the session JWT. Use a long random string.
JWT_SECRET="82fbc8e53c158422c3ec9bd6734654acd86fcae5101f1330f33345eac79b0306"

# --- Cron ---
# Secret required to trigger the daily reminder job. On Vercel Cron this is
# sent automatically as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET="3e171da9b13af887a4e729d1b0c99179"

# --- Admin ---
# Required in the Authorization: Bearer header to create users via POST /api/users.
# There is no public signup — provision the 2-3 backend users from Postman.
REGISTER_SECRET="3e171da9b13af887a4e729d1b0c99179"

# --- Encryption ---
# 32-byte key (64 hex chars) used to encrypt each user's Gmail app password at
# rest (AES-256-GCM). Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: changing this makes existing encrypted app passwords undecryptable.
ENCRYPTION_KEY="replace-with-64-hex-chars"

# --- App ---
# Public base URL used inside reminder emails.
APP_URL="http://localhost:3000"
